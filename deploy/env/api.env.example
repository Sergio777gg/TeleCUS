# Template for /etc/telecus/api.env. Fill privately; never commit the real file.
# First server: one backend process, SQLite local to this server, existing Supabase.
NODE_ENV=production
DATA_MODE=supabase-readonly
API_HOST=127.0.0.1
API_PORT=5173
APP_ORIGIN=https://telecus.universidad.example
PROCESS_KIND=api
RUN_WORKER=true
RUN_DELIVERY_WORKER=false
SQLITE_FILE=/var/lib/telecus/telecus.sqlite
DATABASE_URL=
SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR
AGENDA_DATABASE_URL=REEMPLAZAR_CON_CONEXION_DEL_USUARIO_LIMITADO
AGENDA_CA_FILE=/etc/telecus/supabase-ca.crt
TELECUS_INTERNAL_TOKEN=REEMPLAZAR_CON_SECRETO_ALEATORIO
# Preserve the existing encryption key when transferring tokens and queued jobs.
# A new key requires reauthorization or a controlled reciphering operation.
DEMO_SESSION_SECRET=REEMPLAZAR_CON_CLAVE_DE_CIFRADO
# Private receipt bytes: persist this directory together with their Supabase metadata.
PAYMENT_FILES_DIRECTORY=/var/lib/telecus/payment-receipts
# Empty uses the preserved DEMO_SESSION_SECRET. Never rotate the effective key without reciphering files.
PAYMENT_FILES_KEY=
INFERENCE_URL=http://127.0.0.1:1880/telecus/internal/interpret
MODEL_TIMEOUT_MS=120000
TELECUS_AI_MODEL=telecus-local
KNOWLEDGE_DIRECTORY=/opt/telecus/current/knowledge/telecus
GOOGLE_OAUTH_CLIENT_FILE=/etc/telecus/google-client.json
GOOGLE_TOKEN_FILE=/var/lib/telecus/google-tokens.enc
GOOGLE_AUTHORIZATION_URL_FILE=/var/lib/telecus/google-authorization-url.local.txt
GOOGLE_CALENDAR_ID=citascus@gmail.com
GOOGLE_SENDER=citascus@gmail.com
PAYMENT_URL=
