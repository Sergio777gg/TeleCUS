# Template for /etc/telecus/node-red.env. No Supabase or Google credentials here.
NODE_ENV=production
NODE_RED_HOST=127.0.0.1
NODE_RED_PORT=1880
NODE_RED_DISABLE_EDITOR=true
NODE_RED_ENTRY=/opt/telecus-tools/node_modules/node-red/red.js
# Must match the API's TELECUS_INTERNAL_TOKEN.
TELECUS_INTERNAL_TOKEN=REEMPLAZAR_CON_EL_MISMO_SECRETO_INTERNO
OLLAMA_URL=http://127.0.0.1:11434
TELECUS_AI_MODEL=telecus-local
TELECUS_AI_CONTEXT=8192
