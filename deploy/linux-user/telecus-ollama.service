[Unit]
Description=TeleCUS modelo local Ollama

[Service]
WorkingDirectory=%h/telecus-fiet
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MODELS=%h/.ollama/models
ExecStart=%h/telecus-fiet/ollama/bin/ollama serve
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
