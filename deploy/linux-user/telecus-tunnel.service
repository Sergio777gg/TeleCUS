[Unit]
Description=TeleCUS tunel de prueba Cloudflare HTTP2
Wants=telecus-app.service
After=telecus-app.service

[Service]
WorkingDirectory=%h/telecus-fiet
ExecStart=%h/telecus-fiet/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:5173 --protocol http2 --metrics 127.0.0.1:20242
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
